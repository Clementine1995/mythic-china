---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { readBuildIntent } from "../site/build-intent";
import { loadPublicAssembly } from "../site/load-public-assembly";
import {
  analyticsConfigurationName,
  createPublicAnalyticsConfiguration,
} from "../site/analytics-configuration";
import { serializeJsonLd } from "../site/seo";
import { isNewsletterEnabled } from "../site/newsletter-configuration";
import { fontAssetUrls } from "../typography/font-assets";
import "../styles/fonts.css";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  pageClass?: string;
  preloadStoryFont?: boolean;
}

const { title, description, pageClass, preloadStoryFont = false } = Astro.props;
const intent = readBuildIntent();
const assembly = intent === "public" ? await loadPublicAssembly() : null;
const analyticsConfiguration = assembly
  ? createPublicAnalyticsConfiguration(assembly.site, assembly.descriptors)
  : null;
const pagePath = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const metadata = assembly?.metadata.find(
  (page) => page.canonical === `${assembly.site.origin}${pagePath}`,
);
const documentTitle =
  title === "Mythic China" ? title : `${title} | Mythic China`;
if (
  intent === "public" &&
  (!metadata ||
    metadata.documentTitle !== documentTitle ||
    metadata.description !== description)
) {
  throw new Error(
    `Public page metadata does not match its rendered identity: ${pagePath}`,
  );
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="dark" />
    {
      analyticsConfiguration && (
        <meta
          name={analyticsConfigurationName}
          content={JSON.stringify(analyticsConfiguration)}
        />
      )
    }
    <link
      rel="preload"
      href={fontAssetUrls.displayRoman}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    {
      preloadStoryFont && (
        <link
          rel="preload"
          href={fontAssetUrls.storyRoman}
          as="font"
          type="font/woff2"
          crossorigin="anonymous"
        />
      )
    }
    {description && <meta name="description" content={description} />}
    <meta name="robots" content={metadata?.robots ?? "noindex, nofollow"} />
    {
      metadata && (
        <>
          <link rel="canonical" href={metadata.canonical} />
          <link
            rel="alternate"
            type="application/rss+xml"
            title="Mythic China"
            href="/rss.xml"
          />
          <meta property="og:title" content={metadata.openGraph.title} />
          <meta
            property="og:description"
            content={metadata.openGraph.description}
          />
          <meta property="og:type" content={metadata.openGraph.type} />
          <meta property="og:url" content={metadata.openGraph.url} />
          <meta property="og:site_name" content={metadata.openGraph.siteName} />
          <script
            is:inline
            type="application/ld+json"
            set:html={serializeJsonLd(metadata.structuredData)}
          />
        </>
      )
    }
    <title>{documentTitle}</title>
  </head>
  <body class={pageClass}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader currentPath={Astro.url.pathname} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <SiteFooter
      showPublicBeta={intent === "public"}
      newsletter={{
        buildIntent: intent,
        siteOrigin: assembly?.site.origin,
        isEnabled: isNewsletterEnabled,
      }}
    />
  </body>
</html>
