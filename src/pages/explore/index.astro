---
import { loadValidatedContentGraph } from "../../content/load-validated-content-graph";
import IllustratedLink from "../../components/IllustratedLink.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { readBuildIntent } from "../../site/build-intent";
import { createPageProjection } from "../../site/page-projection";
import { getReviewIndexPreview } from "../../site/review-projection";
import { resolveApprovedPageAssetById } from "../../visual/resolve-approved-page-asset";

const intent = readBuildIntent();
const graph = await loadValidatedContentGraph();
const projection = createPageProjection(graph, intent);
const { publishedEntries } = projection;
const illustratedEntries = publishedEntries.map((entry) => {
  if (entry.data.heroAssetId === null || entry.data.subtitle === null) {
    throw new Error(`Explore Entry ${entry.id} requires a Hero and subtitle.`);
  }
  const asset = resolveApprovedPageAssetById(
    graph.assets,
    entry.data.heroAssetId,
    {
      ownerType: "entry",
      ownerId: entry.id,
      role: "hero",
      slotId: "primary",
      accessibilityMode: "informative",
    },
  );
  return { entry, asset, intro: entry.data.subtitle };
});
const reviewEntries =
  intent === "review" && publishedEntries.length === 0
    ? getReviewIndexPreview(projection).entries
    : [];
---

<SiteLayout
  title="Explore"
  description="Browse published Mythic China stories and cultural guides."
>
  <header class="index-hero page-shell section-space">
    <p class="section-context">Explore</p>
    <h1>Stories and traditions</h1>
    <p>
      Browse stories and cultural guides. {
        reviewEntries.length > 0 &&
          "Current editorial candidates are shown separately from the published index."
      }
    </p>
  </header>

  {
    reviewEntries.length > 0 && (
      <section
        class="review-preview page-shell section-space"
        aria-labelledby="entry-review-preview-heading"
        data-review-preview="entries"
      >
        <header class="review-preview__heading">
          <h2 id="entry-review-preview-heading">Local review preview</h2>
          <p>
            <strong>Not published.</strong> These entries are available for
            local review and may change before release.
          </p>
        </header>

        <ol class="review-preview-list">
          {reviewEntries.map((entry) => (
            <li>
              <p class="review-preview-list__type">{entry.data.entryType}</p>
              <h3>
                <a
                  href={`/explore/${entry.data.slug}/`}
                  data-review-candidate="entry"
                >
                  {entry.data.title}
                </a>
              </h3>
              {entry.data.summary && (
                <p class="review-preview-list__summary">{entry.data.summary}</p>
              )}
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <section class="index-results page-shell section-space" aria-live="polite">
    {
      publishedEntries.length > 0 ? (
        <ol class="editorial-index">
          {illustratedEntries.map(({ entry, asset, intro }) => (
            <li>
              <IllustratedLink
                {asset}
                {intro}
                href={`/explore/${entry.data.slug}/`}
                title={entry.data.title}
                context={entry.data.entryType}
                sizes="(max-width: 767px) 32vw, 34vw"
              />
            </li>
          ))}
        </ol>
      ) : (
        <div class="honest-empty-state">
          <h2>No published entries yet</h2>
          <p>
            Entries appear here only after research, editorial, visual, and
            publication review are complete.
          </p>
        </div>
      )
    }
  </section>
</SiteLayout>
