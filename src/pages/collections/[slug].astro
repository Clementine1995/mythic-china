---
import type { GetStaticPaths } from "astro";
import type { CollectionEntry } from "astro:content";

import { loadValidatedContentGraph } from "../../content/load-validated-content-graph";
import { readBuildIntent } from "../../site/build-intent";
import {
  createReviewProjection,
  getReviewCollectionEntries,
  getReviewFeaturedEntry,
} from "../../site/review-projection";
import CollectionTemplate from "../../templates/CollectionTemplate.astro";
import { resolveApprovedPageAssetById } from "../../visual/resolve-approved-page-asset";
import type { ResolvedAssetRecord } from "../../visual/resolve-visual-assets";

interface Props {
  collection: CollectionEntry<"collections">;
  entries: CollectionEntry<"entries">[];
  featuredEntry: CollectionEntry<"entries"> | null;
  heroAsset: ResolvedAssetRecord | null;
}

export const getStaticPaths: GetStaticPaths = async () => {
  readBuildIntent();
  const graph = await loadValidatedContentGraph();
  const projection = createReviewProjection(graph);

  return projection.collections.map((collection) => {
    const heroAsset = collection.data.heroAssetId
      ? resolveApprovedPageAssetById(
          graph.assets,
          collection.data.heroAssetId,
          {
            ownerType: "collection",
            ownerId: collection.id,
            role: "hero",
            slotId: "primary",
            accessibilityMode: "informative",
          },
        )
      : null;

    return {
      params: { slug: collection.data.slug },
      props: {
        collection,
        entries: getReviewCollectionEntries(
          collection.data.entryIds,
          projection.entries,
        ),
        featuredEntry: getReviewFeaturedEntry(
          collection.data.featuredEntryId,
          projection.entries,
        ),
        heroAsset,
      } satisfies Props,
    };
  });
};

const props = Astro.props;
---

<CollectionTemplate {...props} />
