---
import { loadValidatedContentGraph } from "../../content/load-validated-content-graph";
import IllustratedLink from "../../components/IllustratedLink.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { readBuildIntent } from "../../site/build-intent";
import { createPageProjection } from "../../site/page-projection";
import { getReviewIndexPreview } from "../../site/review-projection";
import { resolveApprovedPageAssetById } from "../../visual/resolve-approved-page-asset";

const intent = readBuildIntent();
const graph = await loadValidatedContentGraph();
const projection = createPageProjection(graph, intent);
const { publishedCollections } = projection;
const illustratedCollections = publishedCollections.map((collection) => {
  if (collection.data.heroAssetId === null) {
    throw new Error(`Collection index ${collection.id} requires a Hero.`);
  }
  const asset = resolveApprovedPageAssetById(
    graph.assets,
    collection.data.heroAssetId,
    {
      ownerType: "collection",
      ownerId: collection.id,
      role: "hero",
      slotId: "primary",
      accessibilityMode: "informative",
    },
  );
  return { collection, asset };
});
const reviewCollection =
  intent === "review" && publishedCollections.length === 0
    ? getReviewIndexPreview(projection).collection
    : null;
---

<SiteLayout
  title="Collections"
  description="Explore curated Mythic China reading paths."
>
  <header class="index-hero page-shell section-space">
    <p class="section-context">Collections</p>
    <h1>Curated reading paths</h1>
    <p>
      Follow curated reading paths. {
        reviewCollection !== null &&
          "Current editorial candidates are shown separately from the published index."
      }
    </p>
  </header>

  {
    reviewCollection !== null && (
      <section
        class="review-preview page-shell section-space"
        aria-labelledby="collection-review-preview-heading"
        data-review-preview="collections"
      >
        <header class="review-preview__heading">
          <h2 id="collection-review-preview-heading">Local review preview</h2>
          <p>
            <strong>Not published.</strong> This reading path is available for
            local review and may change before release.
          </p>
        </header>

        <ol class="review-preview-list">
          <li>
            <p class="review-preview-list__type">Curated collection</p>
            <h3>
              <a
                href={`/collections/${reviewCollection.data.slug}/`}
                data-review-candidate="collection"
              >
                {reviewCollection.data.title}
              </a>
            </h3>
            <p class="review-preview-list__summary">
              {reviewCollection.data.description}
            </p>
          </li>
        </ol>
      </section>
    )
  }

  <section class="index-results page-shell section-space" aria-live="polite">
    {
      publishedCollections.length > 0 ? (
        <ol class="editorial-index">
          {illustratedCollections.map(({ collection, asset }) => (
            <li>
              <IllustratedLink
                {asset}
                href={`/collections/${collection.data.slug}/`}
                title={collection.data.title}
                intro={collection.data.description}
                context="Curated collection"
                sizes="(max-width: 767px) 32vw, 34vw"
              />
            </li>
          ))}
        </ol>
      ) : (
        <div class="honest-empty-state">
          <h2>No published collections yet</h2>
          <p>
            A collection appears here only when its complete reading path is
            ready for publication.
          </p>
        </div>
      )
    }
  </section>
</SiteLayout>
