---
import { loadValidatedContentGraph } from "../../content/load-validated-content-graph";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { readBuildIntent } from "../../site/build-intent";
import {
  createReviewProjection,
  getReviewIndexPreview,
} from "../../site/review-projection";

readBuildIntent();
const graph = await loadValidatedContentGraph();
const projection = createReviewProjection(graph);
const { publishedCollections } = projection;
const { collection: reviewCollection } = getReviewIndexPreview(projection);
---

<SiteLayout
  title="Collections"
  description="Explore curated Mythic China reading paths."
>
  <header class="index-hero page-shell section-space">
    <p class="section-context">Collections</p>
    <h1>Curated reading paths</h1>
    <p>
      Follow curated reading paths. Current editorial candidates are shown
      separately from the published index.
    </p>
  </header>

  <section
    class="review-preview page-shell section-space"
    aria-labelledby="collection-review-preview-heading"
    data-review-preview="collections"
  >
    <header class="review-preview__heading">
      <h2 id="collection-review-preview-heading">Local review preview</h2>
      <p>
        <strong>Not published.</strong> This reading path remains under editorial
        review and may change before release.
      </p>
    </header>

    <ol class="review-preview-list">
      <li>
        <p class="review-preview-list__type">Curated collection</p>
        <h3>
          <a
            href={`/collections/${reviewCollection.data.slug}/`}
            data-review-candidate="collection"
          >
            {reviewCollection.data.title}
          </a>
        </h3>
        <p class="review-preview-list__summary">
          {reviewCollection.data.description}
        </p>
      </li>
    </ol>
  </section>

  <section class="index-results page-shell section-space" aria-live="polite">
    {
      publishedCollections.length > 0 ? (
        <ol class="editorial-index">
          {publishedCollections.map((collection) => (
            <li>
              <h2>
                <a href={`/collections/${collection.data.slug}/`}>
                  {collection.data.title}
                </a>
              </h2>
              <p>{collection.data.description}</p>
            </li>
          ))}
        </ol>
      ) : (
        <div class="honest-empty-state">
          <h2>No published collections yet</h2>
          <p>
            A collection appears here only when its complete reading path is
            ready for publication.
          </p>
        </div>
      )
    }
  </section>
</SiteLayout>
