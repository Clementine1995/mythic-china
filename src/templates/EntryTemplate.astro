---
import { render, type CollectionEntry } from "astro:content";

import ManifestHeroPicture from "../components/ManifestHeroPicture.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import type { ResolvedAssetRecord } from "../visual/resolve-visual-assets";

interface Props {
  entry: CollectionEntry<"entries">;
  collections: CollectionEntry<"collections">[];
  relatedEntries: CollectionEntry<"entries">[];
  sources: CollectionEntry<"sources">[];
  heroAsset: ResolvedAssetRecord | null;
}

const { entry, collections, relatedEntries, sources, heroAsset } = Astro.props;
const { Content } = await render(entry);
// Empty editorial fields stay absent; draft metadata is not substituted as reader copy.
const hasBody = Boolean(entry.body?.trim());
const hasChineseIdentity = entry.data.nameZh !== null;
const entryTypeLabel =
  entry.data.entryType.charAt(0).toUpperCase() + entry.data.entryType.slice(1);
const factCheckedLabel = entry.data.lastFactCheckedAt
  ? new Intl.DateTimeFormat("en-US", {
      dateStyle: "long",
      timeZone: "UTC",
    }).format(new Date(`${entry.data.lastFactCheckedAt}T00:00:00Z`))
  : null;
---

<SiteLayout
  title={entry.data.title}
  description={entry.data.summary ?? undefined}
  preloadStoryFont
>
  <article
    class:list={[
      "entry-page",
      heroAsset ? "entry-page--visual" : "entry-page--simple",
    ]}
  >
    {
      heroAsset ? (
        <header class="entry-hero page-shell">
          <div class="entry-hero__identity">
            <p class="entry-context">{entryTypeLabel}</p>
            <h1>{entry.data.title}</h1>
            {hasChineseIdentity && (
              <p class="bilingual-name entry-chinese-name">
                <span lang="zh-Hans">{entry.data.nameZh}</span>
                <span lang="zh-Latn-pinyin">{entry.data.pinyin}</span>
              </p>
            )}
            {entry.data.subtitle && (
              <p class="entry-dek">{entry.data.subtitle}</p>
            )}
          </div>

          <figure class="entry-hero__figure">
            <ManifestHeroPicture
              asset={heroAsset}
              sizes="(max-width: 767px) 100vw, 90vw"
              priority
            />
            <figcaption class="visual-note">
              <span>{heroAsset.data.caption}</span>
              <span>
                {heroAsset.data.credit}. {heroAsset.data.aiDisclosure}
              </span>
            </figcaption>
          </figure>
        </header>
      ) : (
        <header class="entry-simple-header page-shell section-space">
          <p class="entry-context">{entryTypeLabel}</p>
          <h1>{entry.data.title}</h1>
          {hasChineseIdentity && (
            <p class="bilingual-name entry-chinese-name">
              <span lang="zh-Hans">{entry.data.nameZh}</span>
              <span lang="zh-Latn-pinyin">{entry.data.pinyin}</span>
            </p>
          )}
          {entry.data.subtitle && (
            <p class="entry-dek">{entry.data.subtitle}</p>
          )}
        </header>
      )
    }

    <div class="entry-attribution page-shell">
      <p>
        By <span>Mythic China Editorial</span>
      </p>
      {
        entry.data.lastFactCheckedAt && factCheckedLabel && (
          <p>
            Fact checked{" "}
            <time datetime={entry.data.lastFactCheckedAt}>
              {factCheckedLabel}
            </time>
          </p>
        )
      }
    </div>

    <div class="entry-reading page-shell section-space">
      {
        entry.data.opening.length > 0 && (
          <section class="entry-opening" aria-label="Opening">
            {entry.data.opening.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </section>
        )
      }

      {
        entry.data.summary && (
          <section class="entry-section" aria-labelledby="quick-answer-heading">
            <p class="section-context">At a glance</p>
            <h2 id="quick-answer-heading">Quick Answer</h2>
            <p>{entry.data.summary}</p>
          </section>
        )
      }

      {
        hasBody && (
          <section class="entry-prose" aria-label="Story">
            <Content />
          </section>
        )
      }

      {
        sources.length > 0 && (
          <section class="source-section" aria-labelledby="sources-heading">
            <div class="entry-section__heading">
              <p class="section-context">Evidence record</p>
              <h2 id="sources-heading">Sources</h2>
            </div>
            <ol class="source-list">
              {sources.map((source) => (
                <li>
                  <p class="source-list__type">
                    {source.data.sourceType.replaceAll("-", " ")}
                  </p>
                  <h3>{source.data.title}</h3>
                  {source.data.titleZh && (
                    <p
                      class="source-list__chinese-title"
                      lang={source.data.titleZhLang}
                    >
                      {source.data.titleZh}
                    </p>
                  )}
                  <dl class="source-metadata">
                    {source.data.authorOrOrganization && (
                      <div>
                        <dt>Author / organization</dt>
                        <dd>{source.data.authorOrOrganization}</dd>
                      </div>
                    )}
                    {source.data.publicationOrEdition && (
                      <div>
                        <dt>Publication</dt>
                        <dd>{source.data.publicationOrEdition}</dd>
                      </div>
                    )}
                    {source.data.editionBasisOrObjectId && (
                      <div>
                        <dt>Record</dt>
                        <dd>{source.data.editionBasisOrObjectId}</dd>
                      </div>
                    )}
                    {source.data.originalPeriod && (
                      <div>
                        <dt>Period</dt>
                        <dd>{source.data.originalPeriod}</dd>
                      </div>
                    )}
                    {source.data.publicationYear !== null && (
                      <div>
                        <dt>Year</dt>
                        <dd>{source.data.publicationYear}</dd>
                      </div>
                    )}
                    {source.data.translator && (
                      <div>
                        <dt>Translator</dt>
                        <dd>{source.data.translator}</dd>
                      </div>
                    )}
                    {source.data.pageOrSection && (
                      <div>
                        <dt>Locator</dt>
                        <dd>{source.data.pageOrSection}</dd>
                      </div>
                    )}
                    <div>
                      <dt>Language</dt>
                      <dd>{source.data.language}</dd>
                    </div>
                    {source.data.accessedAt && (
                      <div>
                        <dt>Accessed</dt>
                        <dd>
                          <time datetime={source.data.accessedAt}>
                            {source.data.accessedAt}
                          </time>
                        </dd>
                      </div>
                    )}
                    {source.data.rightsStatus && (
                      <div>
                        <dt>Rights</dt>
                        <dd>{source.data.rightsStatus}</dd>
                      </div>
                    )}
                  </dl>
                  {source.data.url && (
                    <a
                      href={source.data.url}
                      aria-label={`Open source record: ${source.data.title}`}
                    >
                      Open source record
                    </a>
                  )}
                  {source.data.rightsUrl && (
                    <a
                      class="source-rights-link"
                      href={source.data.rightsUrl}
                      aria-label={`Open rights information for: ${source.data.title}`}
                    >
                      Rights information
                    </a>
                  )}
                </li>
              ))}
            </ol>
          </section>
        )
      }

      {
        collections.length > 0 && (
          <nav class="entry-section" aria-labelledby="collections-heading">
            <p class="section-context">Reading path</p>
            <h2 id="collections-heading">Part of a collection</h2>
            <ul class="related-entries">
              {collections.map((collection) => (
                <li>
                  <a href={`/collections/${collection.data.slug}/`}>
                    {collection.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }

      {
        relatedEntries.length > 0 && (
          <nav class="entry-section" aria-labelledby="related-heading">
            <p class="section-context">Continue exploring</p>
            <h2 id="related-heading">Related entries</h2>
            <ul class="related-entries">
              {relatedEntries.map((relatedEntry) => (
                <li>
                  <a href={`/explore/${relatedEntry.data.slug}/`}>
                    {relatedEntry.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
    </div>
  </article>
</SiteLayout>
