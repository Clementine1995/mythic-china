---
import { render, type CollectionEntry } from "astro:content";

import DebugLayout from "../layouts/DebugLayout.astro";

interface Props {
  entry: CollectionEntry<"entries">;
  collections: CollectionEntry<"collections">[];
  relatedEntries: CollectionEntry<"entries">[];
  sources: CollectionEntry<"sources">[];
  claims: CollectionEntry<"claims">[];
  terminology: CollectionEntry<"terminology">[];
}

const { entry, collections, relatedEntries, sources, claims, terminology } =
  Astro.props;
const { Content } = await render(entry);
const hasBody = Boolean(entry.body?.trim());
const hasChineseIdentity = entry.data.nameZh !== null;
---

<DebugLayout
  title={entry.data.title}
  description={`M2 semantic debug view for ${entry.data.title}.`}
>
  <article>
    <header>
      <p class="status-label">Status: {entry.data.status}</p>
      <p class="record-meta">
        Entry ID: <code>{entry.data.entryId}</code> · Type: {
          entry.data.entryType
        }
      </p>
      <h1>{entry.data.title}</h1>
      {
        hasChineseIdentity && (
          <p lang="zh-Hans">
            {entry.data.nameZh} ·{" "}
            <span lang="zh-Latn-pinyin">{entry.data.pinyin}</span>
          </p>
        )
      }
      {entry.data.subtitle && <p class="record-meta">{entry.data.subtitle}</p>}
      <p class="debug-note">
        This title and every empty section remain working draft data until the
        required research and editorial reviews are complete.
      </p>
    </header>

    <section aria-labelledby="opening-heading">
      <h2 id="opening-heading">Opening</h2>
      {
        entry.data.opening.length > 0 ? (
          entry.data.opening.map((paragraph) => <p>{paragraph}</p>)
        ) : (
          <p class="empty-state">Not supplied at draft status.</p>
        )
      }
    </section>

    <section aria-labelledby="quick-answer-heading">
      <h2 id="quick-answer-heading">Quick Answer</h2>
      {
        entry.data.summary ? (
          <p>{entry.data.summary}</p>
        ) : (
          <p class="empty-state">Not supplied at draft status.</p>
        )
      }
    </section>

    <section aria-labelledby="body-heading">
      <h2 id="body-heading">Article body</h2>
      {
        hasBody ? (
          <Content />
        ) : (
          <p class="empty-state">
            The Markdown body is intentionally empty; M2 does not add
            placeholder cultural facts.
          </p>
        )
      }
    </section>

    <section aria-labelledby="sources-heading">
      <h2 id="sources-heading">Sources</h2>
      {
        sources.length > 0 ? (
          <ul>
            {sources.map((source) => (
              <li>
                <strong>{source.data.title}</strong>
                {source.data.authorOrOrganization &&
                  ` — ${source.data.authorOrOrganization}`}
                {source.data.url && (
                  <>
                    {" · "}
                    <a href={source.data.url}>Source page</a>
                  </>
                )}
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty-state">
            No Source records are linked at draft status.
          </p>
        )
      }
    </section>

    <section aria-labelledby="claims-heading">
      <h2 id="claims-heading">Structured Claims</h2>
      {
        claims.length > 0 ? (
          <ol>
            {claims.map((claim) => (
              <li>
                <p>{claim.data.statement}</p>
                <p class="record-meta">
                  Certainty: {claim.data.certainty} · Type:{" "}
                  {claim.data.claimType} · Context: {claim.data.evidenceContext}
                </p>
                <ul>
                  {claim.data.sourceLinks.map((link) => (
                    <li>
                      <code>{link.sourceId}</code> · {link.role} ·{" "}
                      {link.locator} — {link.note}
                    </li>
                  ))}
                </ul>
              </li>
            ))}
          </ol>
        ) : (
          <p class="empty-state">
            No Claim records are linked at draft status.
          </p>
        )
      }
    </section>

    <section aria-labelledby="terminology-heading">
      <h2 id="terminology-heading">Terminology review</h2>
      {
        terminology.length > 0 ? (
          <dl>
            {terminology.map((term) => (
              <>
                <dt>
                  <span lang="zh-Hans">{term.data.hanzi}</span> ·{" "}
                  <span lang="zh-Latn-pinyin">{term.data.pinyin}</span>
                </dt>
                <dd>
                  {term.data.chosenEnglish} — {term.data.firstUseGloss} (review:{" "}
                  {term.data.reviewStatus})
                </dd>
              </>
            ))}
          </dl>
        ) : (
          <p class="empty-state">
            No Terminology records are linked at draft status.
          </p>
        )
      }
    </section>

    <nav aria-labelledby="collections-heading">
      <h2 id="collections-heading">Collections</h2>
      {
        collections.length > 0 ? (
          <ul>
            {collections.map((collection) => (
              <li>
                <a href={`/collections/${collection.data.slug}/`}>
                  {collection.data.title}
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty-state">This Entry is not in an active Collection.</p>
        )
      }
    </nav>

    <nav aria-labelledby="related-heading">
      <h2 id="related-heading">Related Entries</h2>
      {
        relatedEntries.length > 0 ? (
          <ul>
            {relatedEntries.map((relatedEntry) => (
              <li>
                <a href={`/explore/${relatedEntry.data.slug}/`}>
                  {relatedEntry.data.title}
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty-state">
            No related Entries are linked at draft status.
          </p>
        )
      }
    </nav>
  </article>
</DebugLayout>
