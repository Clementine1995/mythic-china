---
import type { CollectionEntry } from "astro:content";

import ManifestHeroPicture from "../components/ManifestHeroPicture.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import type { ResolvedAssetRecord } from "../visual/resolve-visual-assets";

interface Props {
  collection: CollectionEntry<"collections">;
  entries: CollectionEntry<"entries">[];
  featuredEntry: CollectionEntry<"entries"> | null;
  heroAsset: ResolvedAssetRecord | null;
}

const { collection, entries, featuredEntry, heroAsset } = Astro.props;
---

<SiteLayout
  title={collection.data.title}
  description={collection.data.description}
>
  <article
    class:list={[
      "collection-page",
      heroAsset ? "collection-page--visual" : "collection-page--simple",
    ]}
    data-realm={collection.data.collectionId}
  >
    <header class="collection-hero">
      <div class="collection-hero__inner page-shell">
        <div class="collection-hero__copy">
          <p class="collection-context">Collection</p>
          <h1>{collection.data.title}</h1>
          {
            collection.data.titleZh && (
              <p class="collection-identity">
                <span lang="zh-Hans">{collection.data.titleZh}</span>
                <span lang="zh-Latn-pinyin">{collection.data.pinyin}</span>
              </p>
            )
          }
          <p class="collection-description">{collection.data.description}</p>
        </div>
        {
          heroAsset ? (
            <figure class="collection-hero__figure">
              <ManifestHeroPicture
                asset={heroAsset}
                sizes="(max-width: 767px) 100vw, 90vw"
                priority
              />
              <figcaption class="visual-note">
                <span>{heroAsset.data.caption}</span>
                <span>
                  {heroAsset.data.credit}. {heroAsset.data.aiDisclosure}
                </span>
              </figcaption>
            </figure>
          ) : (
            <div class="collection-hero__surface" aria-hidden="true">
              <div class="realm-surface" />
            </div>
          )
        }
      </div>
    </header>

    <div class="collection-reading page-shell section-space">
      {
        featuredEntry && (
          <section
            class="collection-featured"
            aria-labelledby="featured-entry-heading"
          >
            <div>
              <p class="section-context">Featured story</p>
              <p class="bilingual-name">
                {featuredEntry.data.nameZh && (
                  <span lang="zh-Hans">{featuredEntry.data.nameZh}</span>
                )}
                {featuredEntry.data.pinyin && (
                  <span lang="zh-Latn-pinyin">{featuredEntry.data.pinyin}</span>
                )}
              </p>
            </div>
            <div>
              <h2 id="featured-entry-heading">{featuredEntry.data.title}</h2>
              <a
                class="button-link button-link--quiet"
                href={`/explore/${featuredEntry.data.slug}/`}
              >
                Read the entry
              </a>
            </div>
          </section>
        )
      }

      <section class="guided-path" aria-labelledby="guided-path-heading">
        <div class="guided-path__heading">
          <p class="section-context">Curated order</p>
          <h2 id="guided-path-heading">Follow the guided path</h2>
        </div>
        <ol>
          {
            entries.map((entry, index) => (
              <li>
                <span class="path-position">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <div>
                  <p class="entry-type">{entry.data.entryType}</p>
                  <h3>
                    <a href={`/explore/${entry.data.slug}/`}>
                      {entry.data.title}
                    </a>
                  </h3>
                  {entry.data.nameZh && (
                    <p class="bilingual-name">
                      <span lang="zh-Hans">{entry.data.nameZh}</span>
                      <span lang="zh-Latn-pinyin">{entry.data.pinyin}</span>
                    </p>
                  )}
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <nav class="collection-browse" aria-labelledby="browse-heading">
        <p class="section-context">All entries</p>
        <h2 id="browse-heading">Browse this collection</h2>
        <ul>
          {
            entries.map((entry) => (
              <li>
                <a href={`/explore/${entry.data.slug}/`}>{entry.data.title}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </article>
</SiteLayout>
