---
import type { CollectionEntry } from "astro:content";

import ManifestHeroPicture from "../components/ManifestHeroPicture.astro";
import IllustratedLink from "../components/IllustratedLink.astro";
import IllustrationDetails from "../components/IllustrationDetails.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import type { ResolvedAssetRecord } from "../visual/resolve-visual-assets";

interface Props {
  collections: {
    collection: CollectionEntry<"collections">;
    asset: ResolvedAssetRecord;
  }[];
  entry: CollectionEntry<"entries">;
  heroAsset: ResolvedAssetRecord;
}

const { collections, entry, heroAsset } = Astro.props;
---

<SiteLayout
  title="Mythic China"
  description="An English-language cultural publication for Chinese myths, legends, traditions, and their sources."
  pageClass="page-home"
>
  <section class="home-hero page-shell" aria-labelledby="home-title">
    <div class="home-hero__copy">
      <p class="hero-context">Myths, ghosts, and strange tales</p>
      <h1 id="home-title">Chinese myths, carefully told.</h1>
      <p class="home-hero__dek">
        Meet Zhong Kui, explore the Chinese underworld, and step into the
        strange tales of Liaozhai. Start with a story. Follow it back to its
        sources.
      </p>
      <div class="hero-actions">
        <a class="button-link" href="/collections/">
          Explore the collections
        </a>
        <a class="text-link" href={`/explore/${entry.data.slug}/`}>
          Read Zhong Kui
        </a>
      </div>
    </div>

    <figure class="home-hero__figure" data-hero-asset={heroAsset.data.assetId}>
      <p class="bilingual-name">
        <span lang="zh-Hans">{entry.data.nameZh}</span>
        <span lang="zh-Latn-pinyin">{entry.data.pinyin}</span>
      </p>
      <ManifestHeroPicture
        asset={heroAsset}
        sizes="(max-width: 767px) calc(100vw - 32px), 46vw"
        priority
      />
      <IllustrationDetails asset={heroAsset} />
    </figure>
  </section>

  <section
    class="home-collections section-space page-shell"
    aria-labelledby="collection-heading"
  >
    <header class="home-collections__heading">
      <p class="section-context">Choose a reading path</p>
      <h2 id="collection-heading">Two worlds to begin with.</h2>
      <p>Stories first. Sources always.</p>
    </header>
    <ol class="home-collections__list">
      {
        collections.map(({ collection, asset }) => (
          <li>
            <IllustratedLink
              {asset}
              href={`/collections/${collection.data.slug}/`}
              title={collection.data.title}
              intro={collection.data.description}
              context={
                collection.id === "chinese-underworld"
                  ? "Beliefs & traditions"
                  : "Literature & strange tales"
              }
              heading="h3"
              sizes="(max-width: 767px) calc(100vw - 32px), 46vw"
            >
              {collection.data.titleZh && (
                <p class="bilingual-name">
                  <span lang="zh-Hans">{collection.data.titleZh}</span>
                  <span lang="zh-Latn-pinyin">{collection.data.pinyin}</span>
                </p>
              )}
            </IllustratedLink>
          </li>
        ))
      }
    </ol>
  </section>
</SiteLayout>
