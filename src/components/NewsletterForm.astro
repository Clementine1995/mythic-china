---
import {
  resolveNewsletterAction,
  type NewsletterRenderingContext,
} from "../site/newsletter-configuration";

type Props = NewsletterRenderingContext;

const action = resolveNewsletterAction(Astro.props);
const headingId = "footer-newsletter-heading";
const emailId = "footer-newsletter-email";
const privacyId = "footer-newsletter-privacy";
---

<section
  class="newsletter-form page-shell"
  aria-labelledby={headingId}
  data-review-interaction="newsletter"
  data-review-state={action ? "active" : "inactive"}
>
  <div class="newsletter-form__copy">
    <p class="section-context">Newsletter</p>
    <h2 id={headingId}>New stories, carefully sourced.</h2>
    <p>
      A newsletter for new Mythic China stories and occasional editorial
      selections, no more than twice a month.
    </p>
  </div>

  <div class="newsletter-form__review">
    {
      action ? (
        <>
          <form
            class="newsletter-form__fields"
            action={action}
            method="post"
            accept-charset="UTF-8"
            aria-describedby={privacyId}
          >
            <label for={emailId}>Email address</label>
            <input
              id={emailId}
              type="email"
              name="email"
              autocomplete="email"
              maxlength="254"
              required
            />
            <button class="button-link" type="submit">
              Subscribe
            </button>
          </form>
          <p id={privacyId} class="interaction-privacy-copy">
            Buttondown processes your email address. Check your inbox to confirm
            your subscription. You can unsubscribe at any time. See our{" "}
            <a href="/privacy/">Privacy Notice</a>.
          </p>
        </>
      ) : (
        <>
          <p class="interaction-review-status">
            Newsletter subscriptions are not open yet.
          </p>
          <p class="interaction-privacy-copy">
            We are not collecting email addresses here.{" "}
            <a href="/privacy/">Privacy Notice</a>.
          </p>
        </>
      )
    }
  </div>
</section>
